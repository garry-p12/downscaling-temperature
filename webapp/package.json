{
  "name": "offset-correction-bench",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive bench for the daily-offset correction in the perfect-prognosis downscaling project",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
