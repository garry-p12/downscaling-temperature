# --------------------------------------------------------------------------- #
# Data stores
# Every domain writes to its own root (data_store, data_store_sc,
# data_store_austin, ...), so the glob covers new domains automatically —
# a bare `data_store/` did not, and 1.8 GB of South-Central rasters were one
# `git add .` away from the index.
# --------------------------------------------------------------------------- #
data_store*/
*.zarr/
*.nc
*.tif
*.bil
*.grib
*.hdr

# --------------------------------------------------------------------------- #
# Model artifacts and run outputs
# Same reasoning: `checkpoints_colorado_4ch/` (573 MB) escaped `checkpoints/`.
# --------------------------------------------------------------------------- #
checkpoints*/
runs/
outputs/
wandb/
*.pt
*.ckpt

# Figures and evaluation artifacts — regenerated by evaluation/*.py from the
# checkpoints, so they are build products, not source.
image_outputs/
austin_eval/
*.png

# --------------------------------------------------------------------------- #
# Documentation: README.md is the only tracked document. Everything else
# (results write-ups, reports, reference papers) stays local.
# --------------------------------------------------------------------------- #
*.md
!README.md
*.pdf

# Credentials
.cdsapirc
.env
.aws/

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/

# Editor / tooling local state
.claude/settings.local.json
.vscode/
.idea/

# OS
.DS_Store
